# Q1.1  Recycled-out-of-context photographs.
# Reasoning: a claim-bearing post (schema:Claim schema:appearance ?post) asserts the image shows an event
# (ctx:assertsDepictionOf -> schema:Event schema:startDate). The attached image must be camera-authentic: it has a
# camera-attributed region and NO reliable AI region. "Reliable" follows the org policy (AI confidence >= 0.7), with
# one analyst correction: a 0.5-0.7 AI region still counts as genuine when it is corroborated by a near-duplicate
# showing the same content at >= 0.7, or when the file shows heavy recompression (fkg:ReCompressed and quality
# factor <= 0.75), since recompression is what drags genuine AI regions into that band. Uncorroborated moderate
# regions on lightly compressed files are treated as the detector's known isolated false positives.
# "Same photograph" = identical sha256, OR same near-duplicate cluster AND same detected camera model (the
# clusterer sometimes merges two different photos of a similar scene, so cluster membership alone is not enough).
# Dates: as:published is xsd:dateTime; schema:startDate may be xsd:date or xsd:dateTime, so a date-only start is
# compared on the calendar day (published strictly before the start day).
# Open world: we can only prove "already public" from appearances that are in the crawl; no claim is made about
# posts we did not see.
SELECT DISTINCT ?post WHERE {
  ?claim schema:appearance ?post ;
         ctx:assertsDepictionOf ?event .
  ?event schema:startDate ?start .
  ?post as:attachment ?img .

  # (a) camera-authentic: at least one camera-attributed region and no RELIABLE AI region
  ?img (fkg:hasRegion|^fkg:contained_in)/fkg:produced_by ?camA .
    ?camA a fkg:CameraModel .
  FILTER NOT EXISTS {
    ?img (fkg:hasRegion|^fkg:contained_in) ?rA .
    ?rA fkg:produced_by ?srcA .
    ?srcA a fkg:AIGenerator ; fkg:hasConfidence ?confA .
    FILTER( ?confA >= "0.7"^^xsd:float
         || ( ?confA >= "0.5"^^xsd:float
              && ( EXISTS {
          ?img ctx:inCluster ?clA . ?oA ctx:inCluster ?clA .
          ?oA (fkg:hasRegion|^fkg:contained_in) ?orA .
          ?orA fkg:produced_by ?osA .
          ?osA a fkg:AIGenerator ; fkg:hasConfidence ?ocA .
          FILTER(?oA != ?img && ?ocA >= "0.7"^^xsd:float)
          ?rA fkg:depict ?ctA . ?orA fkg:depict ?octA .
          { ?ctA fkg:hasObjectDescription ?dA . ?octA fkg:hasObjectDescription ?odA .
            FILTER(LCASE(STR(?dA)) = LCASE(STR(?odA))) }
          UNION
          { ?ctA ctx:depictsEntity ?eA . ?octA ctx:depictsEntity ?eA . }
        }
                || EXISTS {
          ?img (fkg:hasRegion|^fkg:contained_in)/fkg:compress_by ?kA .
          { ?kA a fkg:ReCompressed } UNION { ?kA fkg:hasReCompressed true }
          OPTIONAL { ?kA fkg:hasCompressionFactor ?fA }
          FILTER(!BOUND(?fA) || ?fA <= "0.75"^^xsd:float)
        } ) ) )
  }

  # (b) another appearance of the same photograph, published before the event began
  ?earlyPost as:attachment ?img2 ;
             as:published ?pub2 .
  {
      ?img ctx:sha256 ?hE . ?img2 ctx:sha256 ?hE .
    } UNION {
      ?img ctx:inCluster ?pcE . ?img2 ctx:inCluster ?pcE .
      ?img (fkg:hasRegion|^fkg:contained_in)/fkg:produced_by ?maE . ?maE a fkg:CameraModel ; fkg:hasCameraModel ?cmaE .
      ?img2 (fkg:hasRegion|^fkg:contained_in)/fkg:produced_by ?mbE . ?mbE a fkg:CameraModel ; fkg:hasCameraModel ?cmbE .
      FILTER(LCASE(STR(?cmaE)) = LCASE(STR(?cmbE)))
    }
  FILTER( IF(DATATYPE(?start) = xsd:date,
             SUBSTR(STR(?pub2), 1, 10) < SUBSTR(STR(?start), 1, 10),
             COALESCE(?pub2 < ?start, STR(?pub2) < STR(?start))) )
}

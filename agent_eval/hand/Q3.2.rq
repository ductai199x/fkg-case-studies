# CQ3.2 Which images carry a validly signed content credential whose assertions contradict the forensic evidence?
SELECT DISTINCT ?post WHERE {
  ?cr ctx:credentialFor ?img ; ctx:signatureValid true ; ctx:digitalSourceType iptc:digitalCapture . ?post as:attachment ?img .
  { ?img fkg:hasRegion/fkg:produced_by ?s . ?s a fkg:AIGenerator ; fkg:hasConfidence ?c . FILTER(?c >= 0.7)
    BIND("credential asserts digital capture; forensic AI-generated region" AS ?reason) }
  UNION
  { ?cr ctx:claimedCaptureDevice ?dev . ?img fkg:hasRegion/fkg:produced_by ?cs .
    ?cs a fkg:CameraModel ; fkg:hasCameraModel ?cam ; fkg:hasConfidence ?cc . FILTER(?cc >= 0.7 && ?cam != ?dev)
    BIND("credential capture device differs from forensic camera attribution" AS ?reason) }
}

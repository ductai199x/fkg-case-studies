# Baseline (context layer only): reverse-image-search style. Recycled if any near-duplicate was public before the event.
SELECT ?post ?label WHERE {
  ?claim a schema:Claim ; schema:appearance ?post ; ctx:assertsDepictionOf ?event . ?event schema:startDate ?evStart .
  ?post as:attachment ?img .
  BIND(EXISTS { ?img ctx:inCluster ?cl . ?prior ctx:inCluster ?cl . ?pp as:attachment ?prior ; as:published ?pt . FILTER(?pt < ?evStart) } AS ?predates)
  BIND(IF(?predates, "recycled_ooc", "no_problem_found") AS ?label)
}

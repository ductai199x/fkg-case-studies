# Ablation: integrated CQ1.3 trusting every AI attribution regardless of confidence.
SELECT ?post ?label WHERE {
  ?claim a schema:Claim ; schema:appearance ?post ; ctx:assertsDepictionOf ?event .
  ?event schema:startDate ?evStart . ?post as:attachment ?img .
  BIND(EXISTS { ?img fkg:hasRegion/fkg:produced_by ?g . ?g a fkg:AIGenerator } AS ?hasAI)
  BIND(EXISTS { ?img fkg:hasRegion/fkg:produced_by ?c . ?c a fkg:CameraModel } AS ?hasCam)
  BIND(EXISTS { ?img fkg:hasRegion/fkg:produced_by/fkg:hasCameraModel ?cam ; ctx:inCluster ?cl .
                ?prior ctx:inCluster ?cl ; fkg:hasRegion/fkg:produced_by/fkg:hasCameraModel ?cam .
                ?pp as:attachment ?prior ; as:published ?pt . FILTER(?pt < ?evStart) } AS ?predates)
  BIND(IF(?hasAI && !?hasCam, "synthetic", IF(?hasAI, "manipulated", IF(?predates, "recycled_ooc", "no_problem_found"))) AS ?label)
}

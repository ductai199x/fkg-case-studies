# 04: Post-processing chain signatures (ordered op types) on AI-generated regions vs camera regions
PREFIX fkg: <https://example.org/fkg#>
SELECT ?srcType ?chain (COUNT(?r) AS ?n) WHERE {
 { SELECT ?r ?srcType (GROUP_CONCAT(?step; separator=" > ") AS ?chain) WHERE {
   { SELECT ?r ?srcType ?op ?type (COUNT(?pred) AS ?pos) WHERE { GRAPH <https://example.org/cc/graph/forensics> {
      ?r fkg:produced_by ?s ; fkg:modified_by ?op . ?s a ?srcType . ?op a ?type .
      OPTIONAL { ?pred fkg:hasNext+ ?op } } } GROUP BY ?r ?srcType ?op ?type }
   BIND(CONCAT(STR(?pos), ":", STRAFTER(STR(?type), "#")) AS ?step)
 } GROUP BY ?r ?srcType }
} GROUP BY ?srcType ?chain ORDER BY ?srcType DESC(?n)

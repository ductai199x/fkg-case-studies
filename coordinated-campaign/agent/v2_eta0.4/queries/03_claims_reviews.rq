# 03: List fact-checked claims, their ratings, and number of matched appearances
PREFIX schema: <https://schema.org/>
SELECT ?claim ?text ?ratingName ?v (COUNT(DISTINCT ?note) AS ?nApp) WHERE { GRAPH <https://example.org/cc/graph/factcheck> {
  ?review a schema:ClaimReview ; schema:itemReviewed ?claim ; schema:reviewRating ?r .
  ?r schema:ratingValue ?v ; schema:alternateName ?ratingName .
  ?claim schema:text ?text . OPTIONAL { ?claim schema:appearance ?note } } }
GROUP BY ?claim ?text ?ratingName ?v

# 25: Inspect the second TTP-sharing cluster (old accounts posting Sep 28-29): post text, verdict, source, chain+params, claim match, reposts received
PREFIX as: <https://www.w3.org/ns/activitystreams#>
PREFIX fkg: <https://example.org/fkg#>
PREFIX schema: <https://schema.org/>
SELECT ?user ?t ?content ?verdict (GROUP_CONCAT(DISTINCT ?opd; separator=" ") AS ?ops) (SAMPLE(?ct) AS ?claim) (SAMPLE(?nr) AS ?nReposted) WHERE {
  VALUES ?user { "local_cedar896" "rusty_atlas425" "rusty_atlas897" "sunny_atlas47" "daily_ember163" "quiet_cedar104" }
  GRAPH <https://example.org/cc/graph/platform> { ?a as:preferredUsername ?user . ?note as:attributedTo ?a ; as:published ?t ; as:content ?content .
    { SELECT ?note (COUNT(?x) AS ?nr) WHERE { ?note a as:Note . OPTIONAL { ?x a as:Announce ; as:object ?note } } GROUP BY ?note } }
  OPTIONAL { GRAPH <https://example.org/cc/graph/platform> { ?note as:attachment ?img } GRAPH <https://example.org/cc/graph/forensics> { ?rec fkg:aboutImage ?img ; fkg:hasConclusion ?c . ?c fkg:verdict ?v . OPTIONAL { ?c fkg:manipulationType ?mt }
     ?rg fkg:contained_in ?img ; fkg:modified_by ?op ; fkg:produced_by ?s . ?op a ?ot . OPTIONAL { ?op fkg:hasParameter/fkg:hasParameterValue ?pv } OPTIONAL { ?s fkg:hasGeneratorModel|fkg:hasCameraModel ?sm } }
     BIND(CONCAT(?sm, ":", STRAFTER(STR(?ot),"#"), COALESCE(CONCAT("=",STR(?pv)),"")) AS ?opd) }
  OPTIONAL { GRAPH <https://example.org/cc/graph/factcheck> { ?cl schema:appearance ?note ; schema:text ?ct } }
  BIND(COALESCE(STRAFTER(STR(?mt),"#"), STRAFTER(STR(?v),"#"), "-") AS ?verdict)
} GROUP BY ?user ?t ?content ?verdict ORDER BY ?t

# 24: Generic TTP-sharing test (no hard-coded values): per account, #own images whose region has a consecutive op pair (same 2 op types, both params within 0.12) also seen in an image of another account; and #distinct partner accounts
PREFIX fkg: <https://example.org/fkg#>
PREFIX as: <https://www.w3.org/ns/activitystreams#>
SELECT ?user (COUNT(DISTINCT ?img1) AS ?nLinkedImgs) (COUNT(DISTINCT ?a2) AS ?nPartners) WHERE {
  GRAPH <https://example.org/cc/graph/forensics> {
    ?r1 fkg:contained_in ?img1 ; fkg:modified_by ?p1 . ?p1 fkg:hasNext ?q1 . ?p1 a ?tp . ?q1 a ?tq . FILTER(?tp != fkg:NoPostProc && ?tq != fkg:NoPostProc)
    ?p1 fkg:hasParameter/fkg:hasParameterValue ?vp1 . ?q1 fkg:hasParameter/fkg:hasParameterValue ?vq1 .
    ?r2 fkg:contained_in ?img2 ; fkg:modified_by ?p2 . ?p2 fkg:hasNext ?q2 . ?p2 a ?tp . ?q2 a ?tq .
    ?p2 fkg:hasParameter/fkg:hasParameterValue ?vp2 . ?q2 fkg:hasParameter/fkg:hasParameterValue ?vq2 .
    FILTER(?img1 != ?img2 && ABS(?vp1 - ?vp2) <= 0.12 && ABS(?vq1 - ?vq2) <= 0.12) }
  GRAPH <https://example.org/cc/graph/platform> { ?n1 as:attachment ?img1 ; as:attributedTo ?a1 . ?n2 as:attachment ?img2 ; as:attributedTo ?a2 . ?a1 as:preferredUsername ?user . FILTER(?a1 != ?a2) }
} GROUP BY ?user ORDER BY DESC(?nLinkedImgs) DESC(?nPartners)

# 14: Parameter-value histograms (0.1 bins) per op type, split by whether the region is in a 3-op Resampling>Blur>Noise chain
PREFIX fkg: <https://example.org/fkg#>
SELECT ?type ?inChain ?bin (COUNT(*) AS ?n) WHERE { GRAPH <https://example.org/cc/graph/forensics> {
  ?r fkg:modified_by ?op . ?op a ?t ; fkg:hasParameter/fkg:hasParameterValue ?v .
  BIND(EXISTS { ?r fkg:modified_by ?a . ?a a fkg:Resampling ; fkg:hasNext ?b . ?b a fkg:GaussianBlur ; fkg:hasNext ?c . ?c a fkg:GaussianNoise } AS ?inChain)
  BIND(FLOOR(?v*10)/10 AS ?bin) BIND(STRAFTER(STR(?t),"#") AS ?type) } } GROUP BY ?type ?inChain ?bin ORDER BY ?type ?inChain ?bin

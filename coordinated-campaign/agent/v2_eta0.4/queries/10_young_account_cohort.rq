# 10: Account-creation histogram by day since 2026-06 - is there a burst of new accounts?
PREFIX as: <https://www.w3.org/ns/activitystreams#>
SELECT ?month (COUNT(?a) AS ?n) (GROUP_CONCAT(?user; separator=",") AS ?users) WHERE { GRAPH <https://example.org/cc/graph/platform> {
  ?a a as:Person ; as:published ?c ; as:preferredUsername ?user . FILTER(?c >= "2026-06-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>)
  BIND(SUBSTR(STR(?c),1,10) AS ?month) } } GROUP BY ?month ORDER BY ?month

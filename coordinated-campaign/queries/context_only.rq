# context_only: shared fact-checked false claim posted within 72 h, no forensic records
PREFIX fkg:    <https://example.org/fkg#>
PREFIX as:     <https://www.w3.org/ns/activitystreams#>
PREFIX schema: <https://schema.org/>
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX g:      <https://example.org/cc/graph/>

SELECT ?account (COUNT(DISTINCT ?peer) AS ?peers) WHERE {
  { SELECT DISTINCT ?account ?peer WHERE {
  GRAPH g:platform {
    ?n1 as:attributedTo ?account ; as:published ?t1 .
    ?n2 as:attributedTo ?peer    ; as:published ?t2 .
  }
  FILTER(?account != ?peer)
  FILTER(?t2 - ?t1 <= "PT72H"^^xsd:dayTimeDuration && ?t1 - ?t2 <= "PT72H"^^xsd:dayTimeDuration)
  GRAPH g:platform {  }
  GRAPH g:factcheck {
    ?claim schema:appearance ?n1 , ?n2 .
    ?review schema:itemReviewed ?claim ; schema:reviewRating ?rating . ?rating schema:ratingValue ?score .
    FILTER(?score <= 2)
  }
  } }
}
GROUP BY ?account
HAVING (COUNT(DISTINCT ?peer) >= 2)
ORDER BY DESC(?peers)
